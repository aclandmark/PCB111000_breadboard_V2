int main (void)             			//Example 8 Short display
  { 
    char digit[] =  "012333321000";
        char letter;
    char counter=0;
    char direction = 0;
    char segments[8];
    
    setup_HW;
  for(int m = 0; m <=7; m++)segments[m] = 0;
  while(1){
if (counter < 4)letter = 'a';
if (counter == 4) letter = 'f';
if (counter == 5) letter = 'e';
if ((counter >= 6) && (counter <= 9)) letter = 'd';
if (counter == 10) letter = 'c';
if (counter == 11) letter = 'b';
if (counter == 12) letter = 'a';

 if(!(direction)) segments[digit[counter]-'0'] |= (1 << (letter - 'a')); 
 else segments[digit[counter]-'0'] &= (~(1 << (letter - 'a')));  
  display_pattern(segments, 100);
counter  += 1;
if (counter == 12){direction ^= 1; counter = 0;} 
}SW_reset;}



